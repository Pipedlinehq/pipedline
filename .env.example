# Restaurant OS: every environment variable, with a placeholder.
# Copy to .env (never commit it) or set these in the host's environment.
# What each provider needs, the webhook to register and how to check it: docs/GOING_LIVE.md
# Check the credentials you have set, read-only:  pnpm smoke:live

# ── Mode ──────────────────────────────────────────────────────────────────────────────────────
# sim   = every provider simulated (default; development and tests)
# live  = real providers only; refuses to start without the database and email sending
# mixed = real where configured below, simulated otherwise; refused when ROS_ENV=production
ROS_ADAPTERS=sim
# development | production. Set it explicitly on every process: left unset, the web app (which runs
# with NODE_ENV=production) decides production and the worker decides development.
ROS_ENV=development

# ── Core (required for live) ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# 32 random bytes each, base64:  openssl rand -base64 32   (required in production)
ROS_MASTER_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
ROS_SIGNING_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
# The host of the console, the hub and the webhooks. A different registrable domain from the one below.
ROS_PLATFORM_HOST=console.example.com
# Venue sites live at <slug>.<this domain>.
ROS_TENANT_ROOT_DOMAIN=tables.example.com
# http only for local development.
# ROS_SCHEME=https
# ROS_DB_POOL=10

# ── Running it yourself: docs/SELF_HOSTING.md ─────────────────────────────────────────────────
# Check this file before starting:  pnpm check:config
# 1 opens /start on the platform host: anyone with an email address can sign in and start a venue.
# Off by default; venues are then onboarded from the platform console (/platform).
# ROS_SELF_SERVE=1
# The port the web app listens on (pnpm start:web). Default 3000.
# PORT=3000

# ── Email: Resend (required for live) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME
# Transactional mail is sent as <venue-slug>@<this domain>. It must be a verified domain at Resend.
ROS_PLATFORM_SENDING_DOMAIN=mail.example.com

# ── SMS: Twilio (optional; without it texts fail and are recorded as failed) ──────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=REPLACE_ME
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only if the public webhook URL differs from https://<ROS_PLATFORM_HOST>/webhooks/messages/twilio
# TWILIO_WEBHOOK_URL=https://console.example.com/webhooks/messages/twilio
# The sender shown on transactional texts when no Messaging Service is set: a Twilio number or a registered alphanumeric sender.
ROS_PLATFORM_SMS_SENDER=ROS

# ── Custom domains: Vercel (optional; without it the custom-domain step stays blocked) ────────
# VERCEL_API_TOKEN=REPLACE_ME
# VERCEL_PROJECT_ID=prj_REPLACE_ME
# VERCEL_TEAM_ID=team_REPLACE_ME

# ── Square: POS, payments and sign-in (optional) ──────────────────────────────────────────────
# SQUARE_APPLICATION_ID=sq0idp-REPLACE_ME
# SQUARE_APPLICATION_SECRET=sq0csp-REPLACE_ME
# sandbox | production (default production)
# SQUARE_ENVIRONMENT=sandbox
# The signature key of the webhook subscription. Without it Square webhooks are refused and sales arrive by polling only.
# SQUARE_WEBHOOK_SIGNATURE_KEY=REPLACE_ME
# Only if the notification URL registered at Square differs from https://<ROS_PLATFORM_HOST>/webhooks/pos/square
# SQUARE_WEBHOOK_URL=https://console.example.com/webhooks/pos/square

# ── Providers whose credentials each venue enters itself: these only switch them on ───────────
# UBER_DIRECT_ENABLED=1
# DOORDASH_DRIVE_ENABLED=1
# KLAVIYO_ENABLED=1
# META_CAPI_ENABLED=1

# ── Criota (remote MCP behind the hub's gateway; access keys are per venue) ───────────────────
# CRIOTA_MCP_URL=https://REPLACE_ME/mcp

# ── Model: Anthropic (optional in every mode; without it model features say "not set up") ─────
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# ROS_LLM_MODEL_FAST=
# ROS_LLM_MODEL_QUALITY=
# ROS_LLM_FALLBACKS=off

# ── Overrides (rarely needed) ─────────────────────────────────────────────────────────────────
# Adapter keys for sending. Default: resend / twilio when configured.
# ROS_EMAIL_ADAPTER=resend
# ROS_SMS_ADAPTER=twilio

# ── scripts/smoke-live.ts only: lets the smoke check reach providers whose tokens are per venue
# SQUARE_SMOKE_ACCESS_TOKEN=REPLACE_WITH_A_SANDBOX_TEST_ACCOUNT_TOKEN
# CRIOTA_SMOKE_ACCESS_KEY=REPLACE_ME

# ── Development and tests only (refused or ignored in production) ─────────────────────────────
# ROS_CLOCK_START=2026-10-02T08:00:00.000Z
# A simulated Square sign-in page on the platform host, so "Connect Square" can be clicked through with no
# Square account. Only beside the other simulators (sim, or mixed without SQUARE_* set); refused with live.
# ROS_SIM_SQUARE_OAUTH=1
# ROS_INLINE_WORKER=1
